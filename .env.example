# Copiar a .env y completar con valores reales (NUNCA commitear el .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave HS256 en base64 (32 bytes), la misma que usa Usuarios
JWT_KEY=
FRONTEND_BASE_URL=http://localhost:5173
# Ollama (LLM) corriendo en el host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
